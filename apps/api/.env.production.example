NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://hiihive_app:CHANGE_ME@postgres:5432/hiihive?schema=public
REDIS_URL=redis://:CHANGE_ME@redis:6379
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
OTP_SECRET=CHANGE_ME_OTP
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
DEV_EXPOSE_OTP=false
THROTTLE_DISABLED=false
ENABLE_QUEUE=true
CORS_ORIGINS=
PUBLIC_WEB_ORIGIN=https://hiihive.example.com
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_BUCKET=CHANGE_ME
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=https://CHANGE_ME.nyc3.digitaloceanspaces.com
BACKUP_DIR=/var/backups/hiihive
BACKUP_GPG_RECIPIENT=
