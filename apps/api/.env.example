NODE_ENV=development
PORT=3000

# Homebrew PostgreSQL on this machine can use peer auth:
# postgresql://YOUR_OS_USER@localhost:5432/hiihive?schema=public
# Docker Compose uses the credentials below.
DATABASE_URL=postgresql://hiihive:hiihive@localhost:5432/hiihive?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Replace these before any shared or deployed environment.
JWT_ACCESS_SECRET=replace-with-a-random-32-character-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-character-secret
OTP_SECRET=replace-with-a-third-random-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Development only. Production refuses to boot when this is true.
DEV_EXPOSE_OTP=true
THROTTLE_DISABLED=false
ENABLE_QUEUE=false
CORS_ORIGINS=
PUBLIC_WEB_ORIGIN=https://hiihive.app

# local is for development only. Production requires s3.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=var/uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=

# Used only by `npm run seed`. Never reuse this password outside local development.
SEED_ADMIN_EMAIL=admin@hiihive.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin!234

# Dev only: enables clearly-labelled sample CUIMS data. Ignored in production.
ALLOW_DEMO_LMS=false
